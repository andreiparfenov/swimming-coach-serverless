# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# Your Nebius Token Factory API key
NEBIUS_API_KEY=your-tokenfactory-key-here

# Token Factory base URL
TOKENFACTORY_BASE_URL=https://api.tokenfactory.nebius.com/v1/

# Model to use for plan generation
MODEL_ID=meta-llama/Llama-3.3-70B-Instruct

# Object Storage access for fetching the knowledge base at startup.
# Optional for local dev — falls back to the bundled app/data/knowledge_base.json
# if these aren't set or the fetch fails.
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=swim-program
S3_ENDPOINT_URL=https://storage.eu-north1.nebius.cloud

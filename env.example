# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# Your Nebius TokenFactory API key (from the Nebius console)
NEBIUS_API_KEY=your-tokenfactory-key-here

# TokenFactory base URL — check your Nebius console for the correct region
TOKENFACTORY_BASE_URL=https://api.tokenfactory.eu-west1.nebius.com/v1/

# Model to use for plan generation
MODEL_ID=meta-llama/Llama-3.3-70B-Instruct
